<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The countdown runs in a foreground service so it survives the app being closed. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- Fire exactly on time, also while the phone is dozing. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission
    android:name="android.permission.SCHEDULE_EXACT_ALARM"
    android:maxSdkVersion="32" />

  <!-- Optional, only for "go to home screen when time is up". -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application>
    <service
      android:name=".MediaTimerService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
  </application>

</manifest>
